PROJECT_NAME=Dayflow HRMS
VERSION=1.0.0
API_PREFIX=/api

# PostgreSQL — use postgresql+asyncpg:// for the async driver
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hrms_db

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Attendance
STANDARD_WORK_HOURS=8.0

# Redis (optional for V1, required for future real-time features)
REDIS_URL=redis://localhost:6379/0
